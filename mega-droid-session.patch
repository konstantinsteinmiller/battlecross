+// ── PDF ──
+
+// The standard PDF fonts speak Windows-1252: map the few characters outside
+// it, so nothing prints as a stray glyph.
+const CP1252 = new Set([...'€‚ƒ„…†‡ˆ‰Š‹ŒŽ‘’“”•–—˜™š›œžŸ'])
+const SUBST = { '−': '-', '→': '->', '←': '<-', '≤': '<=', '≥': '>=', '♯': '#', '✔': 'x', '½': '1/2' }
