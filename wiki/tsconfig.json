{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["../env.d.ts", "src/**/*", "src/**/*.vue", "../src/**/*.ts"],
  "exclude": ["../src/**/__tests__/*"],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "paths": { "@/*": ["../src/*"] },
    "types": ["vite/client"]
  }
}
