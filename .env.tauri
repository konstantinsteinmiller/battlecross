VITE_APP_DEMO=false
VITE_APP_NATIVE=true

# Self-contained like .env.poki.local: no inherited portal flag may stay true
# (vite.config.ts fails a build with two).
VITE_APP_CRAZY_WEB=false
VITE_APP_CRAZY_GAMES_FULL_RELEASE=false
VITE_APP_GAMEPIX=false
VITE_APP_GAME_MONETIZE=false
VITE_APP_PLAYGAMA=false
VITE_APP_GAME_DISTRIBUTION=false
VITE_APP_YANDEX=false
VITE_APP_POKI=false
VITE_APP_GLITCH=false
VITE_APP_ITCH=false
VITE_APP_WAVEDASH=false

VITE_NODE_ENV=production
VITE_ENABLE_OBFUSCATION=false
VITE_APP_FPS_CAP=60
VITE_APP_DEBUG=false

# ─── Ads: Unity LevelPlay (ironSource) mediating AdMob + Unity Ads ───────────
# Not child-directed (#Store-1): COPPA off, interstitials on, Google UMP
# consent in the EEA/UK/CH. Fill the ids from the LevelPlay / AdMob dashboards
# (roadmap #Store-5..8); scripts/native-ads-gate.mjs refuses a store AAB while
# any is empty.
VITE_APP_SHOW_MEDIATOR_ADS=true
VITE_APP_ADS_CHILD_DIRECTED=false
VITE_APP_LEVELPLAY_ANDROID_APP_ID=
VITE_APP_LEVELPLAY_IOS_APP_ID=
VITE_APP_LEVELPLAY_ANDROID_INTERSTITIAL_ID=
VITE_APP_LEVELPLAY_ANDROID_REWARDED_ID=
VITE_APP_LEVELPLAY_IOS_REWARDED_ID=
VITE_APP_LEVELPLAY_IOS_INTERSTITIAL_ID=
VITE_APP_ADMOB_ANDROID_APP_ID=
VITE_APP_ADMOB_IOS_APP_ID=

# Debug only; the gate refuses a store build with either true.
VITE_APP_ADS_TEST_SUITE=false
VITE_APP_ADS_CONSENT_DEBUG_EEA=false

# Linked from Options (Google Play wants the policy reachable in the app).
VITE_APP_PRIVACY_POLICY_URL=
