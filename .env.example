# Battlecross build switches that are safe to share. Copy what you need into
# `.env` (local dev) or a portal's `.env.<mode>` file. Secrets (the
# leaderboard signing secret, voice API keys) never go here.

# ─── The intro (roadmap #130) ───────────────────────────────────────────────
# A 24 s in-engine intro for a brand-new save (a level-30 hero, five skills,
# a narrator). OFF until the owner switches it on: off, it is never shown and
# its two lazy chunks are never fetched (README, "The intro").
VITE_INTRO_ENABLED=false
