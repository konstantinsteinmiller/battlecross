+    markers: { spawn: noop } as unknown as ClimbHost['markers'],
+    shocks: { spawn: noop } as unknown as ClimbHost['shocks'],
+    hitPlayer: () => 'hit', sfx: (n: string) => { sfx.push(n) }, shake: noop, onPickup: noop, propParent: () => scene,
