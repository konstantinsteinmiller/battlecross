+      const gust = k * period
+      expect(gustWarning(zone, gust - GUST_WARN - 0.05)).toBe(false)
+      expect(gustWarning(zone, gust - GUST_WARN + 0.05)).toBe(true)
+      expect(gustShare(zone, gust - 0.05)).toBe(0)
+      expect(gustWarning(zone, gust + 0.05)).toBe(false)
